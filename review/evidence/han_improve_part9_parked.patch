+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+Popularity baseline: score every product by its number of TRAINING users -- no
+learning, no meta-paths -- and rank each test positive among its fixed 99 negatives
+with the same metrics as every trainer. With uniformly sampled negatives this is a
+strong row: positives are drawn in proportion to popularity, negatives are not. Read
+every model row against it (a meta-path model that barely beats it has learned little
+beyond popularity).
+
+Equal training counts are ordered by a seeded random key (--seed), not against the
+positive: popularity has many ties, and the trainers' pessimistic tie rule would
+understate it.
+
+    python popularity_baseline.py --split-seed 1 --save-emb output/AMAZON/popularity_s1.pt
+
+The blob has the shared format (P_emb = the popularity column, U_emb = ones), so
+eval_emb.py, summarize_results.py and recommend.py accept it like a trained model.
+"""
+
+import argparse
+import os
+
+import numpy as np
+import torch
+
+from data_loader import data_loader
+from link_data import build_link_split
+from han_utils import (NODE_TYPE_IDS, score_edges, evaluate_ranking,
+                       evaluate_ranking_by_user, print_by_user,
+                       evaluate_ranking_stratified, print_stratified,
+                       report_twin_breakdown)
+
+
+def popularity_scores(link_split, seed):
+    """Training degree per product, plus a seeded key in [0, 0.5) that orders ties
+    at random without reordering different counts."""
+    pop = np.asarray(link_split['train_adj_src2dst'].sum(axis=0)).ravel().astype(np.float64)
+    return pop + 0.5 * np.random.default_rng(seed).random(pop.size)
+
+
+def main(args):
+    src_name, dst_name = args.target_relation.split(',')
+    tids = NODE_TYPE_IDS[args.dataset]
+    dl = data_loader(f'{args.root}/{args.dataset}')
+    link_split = build_link_split(dl, tids[src_name], tids[dst_name],
+                                  seed=args.split_seed, num_neg_eval=args.num_neg_eval)
+    P_emb = torch.from_numpy(popularity_scores(link_split, args.seed)).unsqueeze(1)
+    U_emb = torch.ones(link_split['num_src'], 1, dtype=P_emb.dtype)
+
+    val = {}
+    for split in ('val', 'test'):
+        edges = torch.LongTensor(link_split[f'{split}_edges'])
+        negs = torch.LongTensor(link_split[f'{split}_negs'])
+        pos_scores = score_edges(U_emb, P_emb, edges[:, 0], edges[:, 1])
+        neg_scores = score_edges(U_emb, P_emb, edges[:, 0], negs)
+        results = evaluate_ranking(pos_scores, neg_scores)
+        print(f'{split.capitalize()} ranking metrics (training popularity):')
+        for k, v in results.items():
+            print(f'  {k}: {v:.4f}')
+        if split == 'val':
+            val = results
+    print_by_user(evaluate_ranking_by_user(
+        pos_scores, neg_scores, link_split['test_edges'], link_split['test_negs']))
+    deg = np.asarray(link_split['train_adj_src2dst'].sum(axis=1)).ravel()
+    strat = evaluate_ranking_stratified(pos_scores, neg_scores,
+                                        deg[link_split['test_edges'][:, 0]])
+    print('By user training degree:')
+    print_stratified(strat)
+    twin = report_twin_breakdown(pos_scores, neg_scores, link_split, link_split['test_edges'])
+
+    if args.save_emb:
+        os.makedirs(os.path.dirname(args.save_emb) or '.', exist_ok=True)
+        torch.save({'model': 'popularity', 'dataset': args.dataset,
+                    'target_relation': args.target_relation, 'paths': [],
+                    'split_seed': args.split_seed, 'P_emb': P_emb.float(), 'U_emb': U_emb.float(),
+                    'metrics': results, 'metrics_twin': twin, 'metrics_val': val,
+                    'best_val_loss': None, 'best_epoch': None, 'config': vars(args)},
+                   args.save_emb)
+        print(f'Saved to {args.save_emb}')
+    return results
+
+
+def parse_args():
+    ap = argparse.ArgumentParser(
+        description='Training-popularity baseline on the shared link-prediction protocol.',
+        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
+    ap.add_argument('--root', type=str, default='data')
+    ap.add_argument('--dataset', type=str, default='AMAZON')
+    ap.add_argument('--target-relation', type=str, default='U,P')
+    ap.add_argument('--split-seed', type=int, default=1,
+                    help='must match the search/build --split-seed (the LMSPS fleets use 1)')
+    ap.add_argument('--num-neg-eval', type=int, default=99)
+    ap.add_argument('--seed', type=int, default=1, help='seed of the random tie-break key')
+    ap.add_argument('--save-emb', type=str, default='',
+                    help="where to save the blob ('' = do not save)")
+    return ap.parse_args()
+
+
+if __name__ == '__main__':
+    main(parse_args())
