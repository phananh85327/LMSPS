+++ b/tests/test_graphs.py
@@ -0,0 +1,208 @@
+"""Graph construction, leave-fold-out graphs, the stale-graph guard and the baselines.
+
+    python tests/test_graphs.py      (or: python -m pytest tests)
+
+Writes a small random AMAZON-like dataset in HGB format (node.dat / link.dat /
+label.dat) to a temporary directory and runs the real scripts on it. CPU only.
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+import numpy as np
+import scipy.sparse as sp
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, REPO)
+from build_metapath_graphs import build_base_matrices, fold_base, materialize_path  # noqa: E402
+from data_loader import data_loader                                                # noqa: E402
+from link_data import build_link_split, edges_fingerprint, train_folds             # noqa: E402
+
+N_P, N_C, N_U = 120, 12, 60
+
+
+def _write_dataset(root, seed=0):
+    """AMAZON layout: types 0=P 1=C 2=U; relations 0/1 P-P, 2/3 C-C, 4/5 P-C, 6/7 U-P."""
+    rng = np.random.default_rng(seed)
+    d = os.path.join(root, 'AMAZON')
+    os.makedirs(d, exist_ok=True)
+    shift = {0: 0, 1: N_P, 2: N_P + N_C}
+    with open(os.path.join(d, 'node.dat'), 'w', encoding='utf-8') as f:
+        for t, n, dim in ((0, N_P, 4), (1, N_C, 3), (2, N_U, 2)):
+            for i in range(n):
+                f.write(f'{shift[t] + i}\tn{t}_{i}\t{t}\t' + ','.join(f'{x:.3f}' for x in rng.random(dim)) + '\n')
+    rel = {r: set() for r in range(8)}
+    for _ in range(150):
+        a, b = rng.integers(0, N_P, 2)
+        if a != b:
+            rel[0].add((a, b))
+    for c in range(1, N_C):                               # a tree: parent of c is c // 2
+        rel[2].add((c // 2, c))
+    for p in range(N_P):
+        for c in rng.choice(np.arange(N_C // 2, N_C), size=2, replace=False):   # leaves only
+            rel[4].add((p, c))
+    for u in range(N_U):
+        for p in rng.choice(N_P, size=8, replace=False):
+            rel[6].add((u, p))
+    types = {0: (0, 0), 2: (1, 1), 4: (0, 1), 6: (2, 0)}
+    with open(os.path.join(d, 'link.dat'), 'w', encoding='utf-8') as f:
+        for r in (0, 2, 4, 6):
+            ht, tt = types[r]
+            for h, t in sorted(rel[r]):
+                f.write(f'{shift[ht] + h}\t{shift[tt] + t}\t{r}\t1.0\n')
+            for h, t in sorted(rel[r]):                    # reverse relation r + 1
+                f.write(f'{shift[tt] + t}\t{shift[ht] + h}\t{r + 1}\t1.0\n')
+    for name, ids in (('label.dat', range(0, N_P, 2)), ('label.dat.test', range(1, N_P, 2))):
+        with open(os.path.join(d, name), 'w', encoding='utf-8') as f:
+            for i in ids:
+                f.write(f'{i}\tn0_{i}\t0\t{i % 3}\n')
+    return root
+
+
+def _build(root, out, *flags):
+    subprocess.run([sys.executable, os.path.join(REPO, 'build_metapath_graphs.py'), '--root', root,
+                    '--paths', 'PUP,PCP,PUPUP', '--graph-dir', out, *flags],
+                   check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+
+def _split(root, seed=1):
+    dl = data_loader(os.path.join(root, 'AMAZON'))
+    return dl, build_link_split(dl, 2, 0, seed=seed)
+
+
+def test_train_folds():
+    a, b = train_folds(1000, 4, 1), train_folds(1000, 4, 1)
+    assert np.array_equal(a, b) and set(a.tolist()) == {0, 1, 2, 3}
+    assert not np.array_equal(a, train_folds(1000, 4, 2))
+    assert np.bincount(a).min() > 200                           # roughly balanced
+
+
+def test_edges_fingerprint():
+    e = np.array([[0, 1], [2, 3], [4, 5]])
+    assert edges_fingerprint(e) == edges_fingerprint(e[::-1])   # order-free
+    assert edges_fingerprint(e) != edges_fingerprint(np.array([[0, 1], [2, 3], [4, 6]]))
+
+
+def test_kfold_leaves_full_graphs_unchanged():
+    """--kfold adds fold graphs for paths through U only and leaves every full graph
+    byte-identical to a build without it."""
+    with tempfile.TemporaryDirectory() as tmp:
+        root = _write_dataset(tmp)
+        _build(root, os.path.join(tmp, 'plain'))
+        _build(root, os.path.join(tmp, 'folds'), '--kfold', '3')
+        for p in ('PUP', 'PCP', 'PUPUP'):
+            a = sp.load_npz(os.path.join(tmp, 'plain', f'{p}_top20_split1.npz'))
+            b = sp.load_npz(os.path.join(tmp, 'folds', f'{p}_top20_split1.npz'))
+            assert all(np.array_equal(getattr(a, k), getattr(b, k)) for k in ('indptr', 'indices', 'data')), p
+            has_folds = os.path.isfile(os.path.join(tmp, 'folds', f'{p}_top20_split1_fold0of3.npz'))
+            assert has_folds == ('U' in p), p
+
+
+def test_fold_graph_is_built_without_its_fold():
+    """Fold f's graph equals the graph of the training edges outside fold f: none of
+    fold f's edges is in the U-P matrix it was built from."""
+    with tempfile.TemporaryDirectory() as tmp:
+        root = _write_dataset(tmp)
+        _build(root, os.path.join(tmp, 'g'), '--kfold', '3')
+        dl, ls = _split(root)
+        base = build_base_matrices(dl, 'AMAZON', ls)
+        tr = ls['train_edges']
+        fold = train_folds(len(tr), 3, 1)
+        for f in range(3):
+            b = fold_base(base, ls, fold != f)
+            up = b['UP'].tocsr()
+            assert np.asarray(up[tr[fold == f, 0], tr[fold == f, 1]]).max() == 0, 'fold edge in its own graph'
+            assert np.asarray(up[tr[fold != f, 0], tr[fold != f, 1]]).min() == 1, 'other folds missing'
+            assert (b['PU'] != up.T).nnz == 0
+            for p in ('PUP', 'PUPUP'):
+                want = materialize_path(p, b, 20, rng=np.random.default_rng(1))
+                got = sp.load_npz(os.path.join(tmp, 'g', f'{p}_top20_split1_fold{f}of3.npz'))
+                assert (want != got).nnz == 0, (p, f)
+
+
+def test_loader_refuses_graphs_from_other_data():
+    """train_han.load_metapath_graphs refuses graphs whose sidecar disagrees with the run:
+    another split, another fold, another dataset; a legacy sidecar still loads."""
+    import json
+    from train_han import load_metapath_graphs
+    with tempfile.TemporaryDirectory() as tmp:
+        root = _write_dataset(tmp)
+        g = os.path.join(tmp, 'g')
+        _build(root, g, '--kfold', '3')
+        _, ls = _split(root)
+        tr = ls['train_edges']
+        fold = train_folds(len(tr), 3, 1)
+
+        def load(edges, fold_id=None, n=N_P, seed=1):
+            return load_metapath_graphs(g, ['PUP', 'PCP'], 20, seed, n, 'cpu', edges,
+                                        fold=None if fold_id is None else (fold_id, 3))
+
+        def refused(*a, **kw):
+            try:
+                load(*a, **kw)
+            except SystemExit:
+                return True
+            return False
+
+        assert len(load(tr)) == 2
+        assert load(tr[fold != 1], fold_id=1)[1] is None         # PCP has no fold graphs
+        _, other = _split(root, seed=2)
+        assert len(other['train_edges']) == len(tr)
+        assert refused(other['train_edges'])                      # another split, same count
+        assert refused(tr[fold != 2], fold_id=1)                  # another fold's edges
+        assert refused(tr, n=N_P + 1)                             # another dataset
+        # split-1 graphs copied under split 2's names, sidecars edited to match: the
+        # training-edge hash still tells them apart
+        for p in ('PUP', 'PCP'):
+            meta = json.load(open(os.path.join(g, f'{p}_top20_split1.meta.json'), encoding='utf-8'))
+            meta['split_seed'] = 2
+            json.dump(meta, open(os.path.join(g, f'{p}_top20_split2.meta.json'), 'w', encoding='utf-8'))
+            sp.save_npz(os.path.join(g, f'{p}_top20_split2.npz'), sp.load_npz(os.path.join(g, f'{p}_top20_split1.npz')))
+        assert refused(other['train_edges'], seed=2)
+        meta_file = os.path.join(g, 'PUP_top20_split1.meta.json')
+        meta = json.load(open(meta_file, encoding='utf-8'))
+        for k in ('num_train_edges', 'train_edges_hash'):
+            meta.pop(k)                                           # legacy sidecar: loads, warns
+        json.dump(meta, open(meta_file, 'w', encoding='utf-8'))
+        assert len(load(tr)) == 2
+
+
+def test_popularity_baseline():
+    """Training degree decides the order; equal degrees are ordered by the seeded key."""
+    from popularity_baseline import popularity_scores
+    with tempfile.TemporaryDirectory() as tmp:
+        _, ls = _split(_write_dataset(tmp))
+        deg = np.asarray(ls['train_adj_src2dst'].sum(axis=0)).ravel()
+        s = popularity_scores(ls, 1)
+        assert np.array_equal(np.floor(s), deg)                   # the key never crosses a count
+        assert len(np.unique(s)) == len(s)                        # every tie broken
+        assert np.array_equal(s, popularity_scores(ls, 1)) and not np.array_equal(s, popularity_scores(ls, 2))
+
+
+def test_own_share():
+    """check_self_inclusion.own_share: product 0's neighbours {1, 3}, user 0's items {0, 1, 2}
+    -> half of the neighbours are the user's; product 2 has no neighbour -> 0."""
+    from check_self_inclusion import own_share
+    g = sp.csr_matrix((np.ones(4), ([0, 0, 1, 3], [1, 3, 0, 0])), shape=(4, 4))
+    items = sp.csr_matrix((np.ones(3), ([0, 0, 0], [0, 1, 2])), shape=(1, 4))
+    share, anyhit = own_share(g, items, np.array([[0, 0], [0, 2]]))
+    assert abs(share - 0.25) < 1e-9 and abs(anyhit - 0.5) < 1e-9, (share, anyhit)
+
+
+def test_random_pool_matches_the_search_space():
+    """--pool draws from LMSPS's candidates: 55 target-ended paths of 2-6 letters, 36 after
+    reverse dedupe (17 palindromes), every one schema-valid."""
+    from random_paths import SCHEMA, candidate_pool
+    pool = candidate_pool()
+    assert len(pool) == 36 and sum(p == p[::-1] for p in pool) == 17
+    assert all(p == min(p, p[::-1]) and p[0] == p[-1] == 'P' for p in pool)
+    assert all(b in SCHEMA[a] for p in pool for a, b in zip(p, p[1:]))
+    assert {'PP', 'PCP', 'PUP', 'PUPUP'} <= set(pool)
+
+
+if __name__ == '__main__':
+    for name, fn in list(globals().items()):
+        if name.startswith('test_'):
+            fn()
+            print('ok', name)
