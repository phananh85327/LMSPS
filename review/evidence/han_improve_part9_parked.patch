+def edges_fingerprint(edges):
+    """Order-free short hash of an edge set [N, 2]. Graph sidecars record the training
+    edges a graph was built from, so train_han.py can refuse a graph built from other
+    data, another split or another fold."""
+    e = np.unique(np.asarray(edges, dtype=np.int64).reshape(-1, 2), axis=0)
+    return hashlib.blake2b(e.tobytes(), digest_size=8).hexdigest()
+
+
+def train_folds(num_train_edges, k, split_seed):
+    """Fold id in [0, k) per TRAIN edge, fixed by the split seed (not the run seed):
+    build_metapath_graphs.py --kfold builds one graph per fold from the training
+    edges OUTSIDE that fold, and train_han.py / train_gat.py --graph-kfold score
+    each fold's edges on its own graph, so a training edge is never inside the
+    graph it is scored on (a held-out edge never is either)."""
+    return np.random.default_rng(split_seed + 7).integers(0, k, size=num_train_edges)
+
