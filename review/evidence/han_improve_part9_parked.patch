+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+"""
+How much of a training positive's meta-path neighbourhood exists only because of the
+positive itself?
+
+For a TRAINING edge (u, p), every path through U was built with that edge in the U-P
+matrix, so p's neighbours include u's other products partly because u reviewed p. A
+held-out edge never gets that. This prints, per path through U, the share of p's
+neighbours that are u's own training items:
+  - train edges on the graph they are trained on (all training edges),
+  - the same edges on their leave-fold-out graph (needs --kfold: the graphs that
+    build_metapath_graphs.py --kfold K wrote),
+  - test edges on the full graph (what evaluation sees).
+A training share far above the test share means the model learns from a signal it
+will not have at test time (train_han.py --graph-kfold removes it). On a small
+AMAZON graph: PUP 13% for training edges vs 3% for test edges.
+
+    python check_self_inclusion.py --arch amazon_lp_m5 --graph-dir data/AMAZON/metapath_graphs_rebuilt
+    python check_self_inclusion.py --paths PUP,PUPUP --kfold 10 --graph-dir ...
+"""
+
+import argparse
+import os
+
+import numpy as np
+import scipy.sparse as sp
+
+from data_loader import data_loader
+from link_data import build_link_split, train_folds
+from han_utils import NODE_TYPE_IDS
