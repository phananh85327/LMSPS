+def own_share(graph, user_items, edges):
+    """Mean share of p's neighbours (excluding p) that are u's items, and the share of
+    edges with at least one such neighbour, for (u, p) in `edges`."""
+    graph, user_items = graph.tocsr(), user_items.tocsr()
+    deg = np.diff(graph.indptr)[edges[:, 1]]
+    hits = np.asarray(graph[edges[:, 1]].multiply(user_items[edges[:, 0]]).sum(axis=1)).ravel()
+    return float(np.mean(np.where(deg > 0, hits / np.maximum(deg, 1), 0.0))), float(np.mean(hits > 0))
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument('--root', type=str, default='data')
+    ap.add_argument('--dataset', type=str, default='AMAZON')
+    ap.add_argument('--target-relation', type=str, default='U,P')
