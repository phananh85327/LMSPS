+    ap.add_argument('--split-seed', type=int, default=1)
+    ap.add_argument('--kfold', type=int, default=0,
+                    help='also read the leave-fold-out graphs of build_metapath_graphs.py --kfold K')
+    ap.add_argument('--sample', type=int, default=50000,
+                    help='training / test edges sampled per measurement (0 = all)')
+    args = ap.parse_args()
+
+    if args.paths:
+        paths = [p.strip() for p in args.paths.split(',') if p.strip()]
+    elif args.arch:
+        from arch import archs
+        paths = archs[args.arch][0]
+    else:
+        raise SystemExit('pass --arch <arch.py key> or --paths "PUP,..."')
+    src_name, dst_name = args.target_relation.split(',')
+    paths = [p for p in paths if src_name in p]
+    if not paths:
+        raise SystemExit(f'no path visits {src_name}: nothing to measure')
+    tids = NODE_TYPE_IDS[args.dataset]
+    dl = data_loader(f'{args.root}/{args.dataset}')
+    ls = build_link_split(dl, tids[src_name], tids[dst_name], seed=args.split_seed)
+    graph_dir = args.graph_dir or os.path.join(args.root, args.dataset, 'metapath_graphs')
+    tr, te = ls['train_edges'], ls['test_edges']
+    rng = np.random.default_rng(0)
+
+    def sample(edges, idx=None):
+        idx = np.arange(len(edges)) if idx is None else idx
+        if args.sample and len(idx) > args.sample:
+            idx = rng.choice(idx, size=args.sample, replace=False)
+        return edges[idx]
+
+    fold = train_folds(len(tr), args.kfold, args.split_seed) if args.kfold else None
+    print(f'share of p\'s neighbours that are u\'s own training items (any = share of edges with at least one)')
+    print(f'{"path":<8} {"train edges, full graph":>24} {"same, own fold left out":>24} {"test edges":>18}')
+    for p in paths:
+        stem = os.path.join(graph_dir, f'{p}_top{args.topk}_split{args.split_seed}')
+        full = sp.load_npz(stem + '.npz')
+        s_tr, a_tr = own_share(full, ls['train_adj_src2dst'], sample(tr))
+        s_te, a_te = own_share(full, ls['train_adj_src2dst'], sample(te))
+        fold_col = '-'
+        if args.kfold:
+            acc = np.zeros(2)
+            n = 0
+            for f in range(args.kfold):
+                g = sp.load_npz(f'{stem}_fold{f}of{args.kfold}.npz')
+                keep = tr[fold != f]
+                items = sp.csr_matrix((np.ones(len(keep), dtype=np.float32), (keep[:, 0], keep[:, 1])),
+                                      shape=ls['train_adj_src2dst'].shape)
+                e = sample(tr, np.flatnonzero(fold == f))
+                acc += np.array(own_share(g, items, e)) * len(e)
+                n += len(e)
+            fold_col = f'{acc[0] / n:6.1%} ({acc[1] / n:5.1%})'
+        print(f'{p:<8} {f"{s_tr:6.1%} ({a_tr:5.1%})":>24} {fold_col:>24} {f"{s_te:6.1%} ({a_te:5.1%})":>18}')
+
+
+if __name__ == '__main__':
+    main()
